# `make env` creates .env from this file, replacing every change-me with a generated secret. Never commit .env.
# In production the app refuses to start while ADMIN_PASSWORD, POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD or S3_SECRET_KEY
# still contain change-me.

# --- API ---
APP_ENV=production
# Comma-separated origins allowed to make state-changing /api requests (Origin/Referer check)
APP_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
# auto = Secure (and the __Host- cookie prefix) when every APP_ORIGINS entry is https; or set true / false
COOKIE_SECURE=auto
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated CIDRs). Empty = trust nobody: the TCP peer is the
# client IP. Set it to your proxy's address only if you run one in front of the app (see docs/architecture.md).
TRUSTED_PROXIES=

# --- Postgres ---
POSTGRES_USER=ensemble
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ensemble_chat
DATABASE_URL=postgresql+asyncpg://ensemble:change-me@postgres:5432/ensemble_chat

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin-change-me
MINIO_ROOT_PASSWORD=change-me-too-please
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ensemble-chat
S3_ACCESS_KEY=minioadmin-change-me
S3_SECRET_KEY=change-me-too-please

# --- Admin seed (created/promoted on startup if both set) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- LLM ---
# Preferred: copy config/models.example.yaml to config/models.yaml (providers, models, thinking levels).
# Without that file the api falls back to this single OpenAI-compatible endpoint:
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_DEFAULT_MODEL=
# LLM_MODELS=            (optional comma-separated extra models)
LLM_TIMEOUT_SECONDS=300
REPLAY_ENABLED=true
# Path of the registry file inside the api container (config/ is mounted read-only at /app/config)
# MODELS_CONFIG=/app/config/models.yaml

# --- Secrets ---
# Fernet key that encrypts plugin header values at rest. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or: docker compose run --rm --no-deps app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Keep it: losing it makes stored plugin headers unreadable.
SECRETS_KEY=

# --- Uploads / published port ---
MAX_UPLOAD_MB=200
# Concurrent running replies per user (users with a token limit always get 1)
MAX_RUNS_PER_USER=3
WEB_PORT=8090

# --- e2e only: live-model specs (make e2e). Leave empty to skip them; see docs/development.md ---
# E2E_LLM_BASE_URL=
# E2E_LLM_API_KEY=
# E2E_LLM_MODEL=
