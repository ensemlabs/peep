  {
   "after_ms": 150,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "Here's a small helper with full-jitter exponential backoff:\n\n"
  },
  {
   "after_ms": 150,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "```python\n"
  },
  {
   "after_ms": 140,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "import asyncio\nimport random\nfrom typing import Awaitable, Callable, TypeVar\n"
  },
  {
   "after_ms": 160,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "\nT = TypeVar(\"T\")\n"
  },
  {
   "after_ms": 180,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "\n\n"
  },
  {
   "after_ms": 150,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "async def retry(\n    call: Callable[[], Awaitable[T]],\n"
  },
  {
   "after_ms": 170,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "    attempts: int = 5,\n    base: float = 0.2,\n"
  },
  {
   "after_ms": 140,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "    cap: float = 5.0,\n) -> T:\n"
  },
  {
   "after_ms": 160,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "    \"\"\"Run `call`, retrying failures with full-jitter exponential backoff.\"\"\"\n    for attempt in range(attempts):\n"
  },
  {
   "after_ms": 180,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "        try:\n            return await call()\n"
  },
  {
   "after_ms": 150,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "        except Exception:\n            if attempt == attempts - 1:\n"
  },
  {
   "after_ms": 170,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "                raise\n            delay = min(cap, base * 2**attempt)\n"
  },
  {
   "after_ms": 140,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "            await asyncio.sleep(random.uniform(0, delay))\n    raise AssertionError(\"unreachable\")\n"
  },
  {
   "after_ms": 150,
   "op": "delta",
   "part_id": "code",
   "field": "text",
   "text": "```\n"
  },
